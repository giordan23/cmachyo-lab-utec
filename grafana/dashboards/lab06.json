{
  "uid": "benchmarking",
  "title": "Benchmarking bancario · consultas a PDF",
  "tags": ["benchmarking", "rag", "utec"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consultas recibidas",
      "description": "Mensajes procesados por el chat documental.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "targets": [{"refId": "A", "expr": "sum(increase(lab06_chat_mensajes_total[$__range]))"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area", "textMode": "value"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consultas por clasificación",
      "description": "Mensajes clasificados como consulta del benchmarking o fuera de alcance.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (ruta) (rate(lab06_chat_mensajes_total[$__rate_interval])) * 60", "legendFormat": "{{ruta}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Similitud de recuperación RAG",
      "description": "Distribución p50 del score coseno de los fragmentos recuperados. Es una señal operativa, no una métrica de precisión del set de oro.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(lab06_rag_score_bucket[$__rate_interval])))", "legendFormat": "p50 score"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consultas sin contexto recuperado",
      "description": "Tasa de consultas para las que el RAG no encontró fragmentos sobre el umbral.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum(rate(lab06_rag_sin_contexto_total[$__rate_interval])) * 60", "legendFormat": "por minuto"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia de proveedores",
      "description": "Latencia p95 de router, LLM y embeddings externos.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, proveedor) (rate(lab06_api_latencia_segundos_bucket[$__rate_interval])))", "legendFormat": "{{proveedor}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errores de proveedores",
      "description": "Errores reportados por Jev y OpenAI.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (proveedor, tipo) (increase(lab06_api_errores_total[$__rate_interval]))", "legendFormat": "{{proveedor}} · {{tipo}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Costo estimado (USD)",
      "description": "Estimación acumulada según los precios configurados para Jev y OpenAI.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 5},
      "targets": [{"refId": "A", "expr": "sum(increase(lab06_costo_estimado_usd_total[$__range]))"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area", "textMode": "value"}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens por proveedor",
      "description": "Tokens de entrada y salida reportados por los proveedores.",
      "datasource": {"type": "prometheus", "uid": "prom"},
      "gridPos": {"x": 6, "y": 16, "w": 18, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (proveedor, tipo) (rate(lab06_tokens_total[$__rate_interval])) * 60", "legendFormat": "{{proveedor}} · {{tipo}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []},
  "editable": true
}
