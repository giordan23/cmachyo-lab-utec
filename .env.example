# Copia este archivo como ".env" y pon TUS claves. Sin comillas ni espacios alrededor del "=".
# .env está en .gitignore: nunca lo subas a un repositorio ni lo pegues en un chat.

# --- Enrutamiento semántico con Jev (TypeSafe) ------------------------------------------------
ROUTER_PROVIDER=jev
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
ROUTER_MIN_CONFIDENCE=0.55
# Probabilidad (Jev) desde la que un mensaje se marca como posible intento de manipulación
INYECCION_UMBRAL=0.8

# --- OpenAI: LLM del agente + embeddings del RAG ----------------------------------------------
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# Nombre tomado de la lista de modelos del SDK openai 3.29; revisa platform.openai.com/docs/models
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vacío = no se envía. Solo para modelos de razonamiento (low | medium | high).
OPENAI_REASONING_EFFORT=

# --- Aprobación humana -------------------------------------------------------------------------
# Token que pide la página del analista. CÁMBIALO. Vacío = la aprobación queda deshabilitada.
ANALISTA_TOKEN=cambia-este-token

# --- Costos (USD por millón de tokens) para la métrica de costo estimado. Copia los precios vigentes.
PRECIO_JEV_INPUT=0.042
PRECIO_OPENAI_INPUT=0
PRECIO_OPENAI_OUTPUT=0
PRECIO_OPENAI_EMBEDDINGS=0
